<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DevVM-Cleanup</AssemblyName>
    <RootNamespace>DevVmCleanup.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Version kommt aus Directory.Build.props (<Version>) -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DevVmCleanup.Core\DevVmCleanup.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <!-- Hilfe-Seiten und PowerShell-Module liegen als lesbare Dateien neben der exe (auch bei Einzeldatei-Veröffentlichung).
         Neue Module = neue .ps1 im Ordner "modules", ohne neu zu kompilieren. -->
    <Content Include="Help\**\*" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\modules\**\*.ps1" Link="modules\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
